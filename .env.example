# Скопируй в .env и заполни. .env в .gitignore и никогда не коммитится.

# Необязательно. Если пусто — ответы генерирует Claude Code CLI по твоей подписке Claude (Pro/Max).
# Если задан — используется Anthropic API (оплата по токенам): https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# --- Только для telegram.driver: mtproto (по умолчанию используется web — они не нужны) ---
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Необязательно, только для mtproto: пароль, которым шифруется файл сессии (AES-256-GCM).
# Придумай сам. Без него сессия хранится открытым текстом в data/session.enc (права 600).
SESSION_PASSPHRASE=
